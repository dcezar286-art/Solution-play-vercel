{
  "redirects": [
    { "source": "/servicos", "destination": "/#servicos", "statusCode": 301 },
    { "source": "/servicos/", "destination": "/#servicos", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
