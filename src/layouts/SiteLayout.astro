---
// Fonte hospedada no próprio site (sem Google Fonts): Archivo variável, eixos de largura e peso.
import "@fontsource-variable/archivo/wdth.css";
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import "../styles/site.css";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import WhatsAppBar from "../components/site/WhatsAppBar.astro";
import CookieBanner from "../components/site/CookieBanner.astro";
import { brand, type PageKey, type ServiceKey } from "../data/content";
import { siteSeo } from "../data/seo";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** "article" nos posts do blog. */
  ogType?: "website" | "article";
  /** Página atual: destaca o item no menu e vira o parâmetro "service" dos eventos. */
  current?: PageKey;
  /** Serviço enviado nos eventos de medição, quando difere de `current` (ex.: post do blog). */
  service?: ServiceKey;
  /** Mensagem pronta usada pela barra fixa do WhatsApp. */
  whatsappMessage?: string;
  /** Dados estruturados (JSON-LD) específicos da página. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Páginas que não devem aparecer no Google (ex.: 404). */
  noindex?: boolean;
}

const {
  title,
  description = siteSeo.defaultDescription,
  ogImage,
  ogType = "website",
  current = "home",
  service: serviceProp,
  whatsappMessage,
  schema,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteSeo.siteUrl).href;
const ogImageUrl = ogImage ? new URL(ogImage, siteSeo.siteUrl).href : new URL("/og-image.png", siteSeo.siteUrl).href;
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const serviceKeys = ["ti", "seguranca", "noc", "dev"];
const service = serviceProp ?? (serviceKeys.includes(current) ? current : "geral");
const trackingEnabled = Boolean(brand.ga4Id || brand.adsId);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07111f" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    {noindex ? null : <link rel="canonical" href={canonicalUrl} />}
    {googleVerification ? <meta name="google-site-verification" content={googleVerification} /> : null}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteSeo.siteName} />
    <meta property="og:locale" content={siteSeo.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    {ogImage ? null : <meta property="og:image:width" content="1200" />}
    {ogImage ? null : <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content="Solution Play: suporte de TI, segurança eletrônica e sistemas em São Paulo" />
    <meta name="twitter:card" content={siteSeo.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body data-page={current} data-service={service}>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <div class="ambient" aria-hidden="true"><div class="ambient__glow"></div><div class="ambient__grid"></div></div>
    <SiteHeader current={current} />
    <main id="conteudo">
      <slot />
    </main>
    <SiteFooter />
    <WhatsAppBar message={whatsappMessage} />
    {trackingEnabled && <CookieBanner />}
    <script>
      import "../scripts/site/pageMotion.ts";
      import "../scripts/site/tracking.ts";
    </script>
  </body>
</html>
