---
/** Página de cada post do blog: /blog/<nome-do-arquivo>/ */
import { render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Icon from "../../components/site/Icon.astro";
import { brand, services, whatsappLink, phoneLink } from "../../data/content";
import { breadcrumbSchema, businessId } from "../../data/schema";
import { getPublishedPosts, postUrl, formatDate, type Post } from "../../data/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, image, imageAlt, service, draft } = post.data;
const url = `${brand.siteUrl}${postUrl(post)}`;
const related = services.find((s) => s.id === service);
const waMessage = `Olá! Li o artigo "${title}" no site e quero falar com um especialista.`;

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    inLanguage: "pt-BR",
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    image: image ? new URL(image, brand.siteUrl).href : `${brand.siteUrl}/og-image.png`,
    author: { "@type": "Organization", "@id": businessId, name: brand.name, url: `${brand.siteUrl}/` },
    publisher: {
      "@type": "Organization",
      "@id": businessId,
      name: brand.name,
      logo: { "@type": "ImageObject", url: `${brand.siteUrl}/apple-touch-icon.png` },
    },
  },
  breadcrumbSchema([
    { name: "Blog", url: `${brand.siteUrl}/blog/` },
    { name: title, url },
  ]),
];
---

<SiteLayout
  title={`${title} | ${brand.name}`}
  description={description}
  ogType="article"
  ogImage={image}
  current="blog"
  service={service}
  whatsappMessage={waMessage}
  schema={schema}
  noindex={draft}
>
  <article class="doc" data-scene="dev-hero" aria-labelledby="post-title">
    <div class="wrap">
      <header class="doc__head">
        <nav class="crumbs" aria-label="Você está em"><a href="/">Início</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a></nav>
        <h1 id="post-title">
          {title}
          {draft && <span class="draft-tag">Rascunho</span>}
        </h1>
        <p class="doc__meta">
          Publicado em <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && <> · Atualizado em <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></>}
        </p>
        <p class="doc__lead">{description}</p>
      </header>
      {image && <img class="post-cover" src={image} alt={imageAlt ?? ""} width="1200" height="630" loading="eager" decoding="async" />}
      <div class="prose">
        <Content />
      </div>
      <aside class="post-cta cta-band" data-track-zone="cta_final" aria-labelledby="post-cta-title">
        <div>
          <h2 id="post-cta-title">Quer ajuda com isso?</h2>
          <p>
            {related ? <>Veja como funciona o nosso serviço de <a class="text-link" href={related.href}>{related.short}</a> ou fale direto com a gente.</> : "Conte o que você precisa. A primeira resposta chega em até 4 horas úteis."}
          </p>
        </div>
        <div class="cta-band__actions">
          <a class="btn btn--primary" href={whatsappLink(waMessage)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Chamar no WhatsApp</a>
          <a class="btn btn--quiet" href={phoneLink}><Icon name="phone" /> Ligar</a>
        </div>
      </aside>
    </div>
  </article>
</SiteLayout>
