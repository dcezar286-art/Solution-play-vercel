---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceTabs from "../components/ServiceTabs.astro";
import LeadForm from "../components/LeadForm.astro";
import InteractiveTopNav from "../components/InteractiveTopNav.astro";
import BenefitsRow from "../components/BenefitsRow.astro";
import HeroOutlineSvg from "../components/HeroOutlineSvg.astro";
import BrandLogo from "../components/BrandLogo.astro";
import ContactTrustIcons from "../components/ContactTrustIcons.astro";
import CinematicScene from "../components/CinematicScene.astro";
import CinematicChapter from "../components/CinematicChapter.astro";
import PricingFinale from "../components/PricingFinale.astro";
import { getImage } from "astro:assets";
import { brand, benefits, differentiators, commercial, contact } from "../data/marketingContent";
import { siteSeo } from "../data/seo";
import heroLogoSrc from "../../LOGO/SolutionPlay.png";

const heroLogoPreload = (
  await getImage({
    src: heroLogoSrc,
    width: 128,
    height: 128,
    format: "webp",
  })
).src;

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteSeo.siteName,
  url: siteSeo.siteUrl,
  email: brand.email,
  telephone: brand.whatsappDisplay,
  taxID: brand.cnpj,
  description: siteSeo.defaultDescription,
};
---

<BaseLayout
  title={siteSeo.defaultTitle}
  homeSpa={true}
  heroLogoPreload={heroLogoPreload}
>
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <div class="cinematic-layout">
    <CinematicScene />
    <InteractiveTopNav />

    <main id="conteudo-principal" class="cinematic-main">
      <CinematicChapter id="brand" labelledby="hero-heading" tone="hero">
        <div class="cinematic-hero studio-hero">
          <p class="studio-hero__eyebrow" data-motion-card="hero-brand"><span></span> TI para empresas em movimento</p>
          <h1 id="hero-heading" class="studio-hero__title" data-motion-card="hero-title">
            Tecnologia<br />que resolve.<br /><span>Seu negócio<br class="studio-mobile-break" /> vai além.</span>
          </h1>
          <p class="studio-hero__lead" data-motion-card="hero-lead">Cuidamos da sua TI.<br />Você transforma o próximo passo em crescimento.</p>
          <div class="studio-hero__actions" data-motion-card="hero-actions">
            <button type="button" class="studio-link" data-chapter-jump="services">Explore nossas soluções <span aria-hidden="true">↗</span></button>
            <button type="button" class="studio-link studio-link--subtle" data-chapter-jump="contact">Vamos conversar <span aria-hidden="true">↗</span></button>
          </div>
        </div>
        <div class="studio-object-caption" aria-hidden="true"><span>SOLUTION CORE</span><span>Um núcleo. Todas as conexões.</span></div>
        <div class="studio-hero__bottom"><span>Suporte · Infraestrutura · Segurança</span><button type="button" data-chapter-jump="services">Role para explorar <span aria-hidden="true">↓</span></button></div>
      </CinematicChapter>

      <CinematicChapter id="services" labelledby="servicos-heading">
        <div class="cinematic-services" data-motion-card="services-panel">
          <div class="scene-signal scene-signal--section" data-motion-card="scene-signal">
            <span>02</span>
            <strong>Módulos de operação</strong>
            <em>os serviços se organizam como camadas do ambiente</em>
          </div>
          <ServiceTabs />
        </div>
      </CinematicChapter>

      <CinematicChapter id="trust" labelledby="confianca-heading">
        <div class="trust-chapter" data-motion-card="trust-panel">
          <div class="scene-signal scene-signal--section" data-motion-card="scene-signal">
            <span>03</span>
            <strong>Base de confiança</strong>
            <em>menos parada, mais segurança e suporte especializado</em>
          </div>
          <p class="section-eyebrow">Por que a Solution Play</p>
          <h2 id="confianca-heading">Tecnologia ativa para o seu negócio</h2>
          <div class="trust-grid">
            {
              benefits.map((item) => (
                <article class="trust-item" data-motion-card="trust-item">
                  <h3>{item.title}</h3>
                  <p>{item.desc}</p>
                </article>
              ))
            }
          </div>
          <ul class="trust-differentiators">
            {differentiators.map((item) => <li>{item}</li>)}
          </ul>
          <p class="trust-site">{brand.siteDisplay}</p>
        </div>
      </CinematicChapter>

      <CinematicChapter id="pricing" labelledby="comercial-heading" tone="pricing">
        <div data-motion-card="pricing-panel">
          <div class="scene-signal scene-signal--section" data-motion-card="scene-signal">
            <span>04</span>
            <strong>Planos de execução</strong>
            <em>contratos mensais claros para cada estágio da empresa</em>
          </div>
          <PricingFinale />
        </div>
      </CinematicChapter>

      <CinematicChapter id="contact" labelledby="contato-heading" tone="contact">
        <div class="wrap lead-grid contact-slide-content" data-motion-card="contact-panel">
          <div class="contact-aside" data-motion-card="contact-copy">
            <div class="scene-signal scene-signal--section" data-motion-card="scene-signal">
              <span>05</span>
              <strong>Convergência</strong>
              <em>o próximo passo vira atendimento direto</em>
            </div>
            <p class="section-eyebrow">Contato</p>
            <p class="contact-service-badge">
              <ContactTrustIcons name="headset" class="contact-service-badge__icon" />
              <span>{contact.badge}</span>
            </p>
            <h2 id="contato-heading">{contact.headline}</h2>
            <p class="contact-aside__lead">{contact.lead}</p>
            <ul class="contact-facts">
              <li>
                <strong>E-mail:</strong>{" "}
                <a href={`mailto:${brand.email}`}>{brand.email}</a>
              </li>
              <li>
                <strong>WhatsApp:</strong>{" "}
                <a href={`https://wa.me/${brand.whatsapp}`} target="_blank" rel="noopener noreferrer">
                  {brand.whatsappDisplay}
                </a>
              </li>
              <li><strong>Planos:</strong> {commercial.plansNote}</li>
            </ul>
            <ul class="contact-trust" aria-label="Garantias de atendimento">
              {
                contact.trustItems.map((item) => (
                  <li class="contact-trust__item">
                    <span class="contact-trust__icon" aria-hidden="true">
                      <ContactTrustIcons name={item.icon} />
                    </span>
                    <span class="contact-trust__text">
                      <strong>{item.title}</strong>
                      <span>{item.desc}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <LeadForm />
        </div>
      </CinematicChapter>
    </main>
  </div>

</BaseLayout>
