---
import SiteLayout from "../layouts/SiteLayout.astro";
import CubeStage from "../components/site/CubeStage.astro";
import ContactForm from "../components/site/ContactForm.astro";
import Testimonials from "../components/site/Testimonials.astro";
import Stats from "../components/site/Stats.astro";
import BlogTeaser from "../components/site/BlogTeaser.astro";
import Icon from "../components/site/Icon.astro";
import { brand, services, trust, differentiators, engagement, policies, whatsappLink, phoneLink } from "../data/content";
import { siteSeo } from "../data/seo";
import { businessSchema } from "../data/schema";

const schema = businessSchema();
---

<SiteLayout title={siteSeo.defaultTitle} current="home" schema={schema}>
  <CubeStage />

  <!-- Início -->
  <section class="hero" id="inicio" data-scene="hero" data-track-zone="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 id="hero-title" class="hero__title" data-intro style="--n:0">Tecnologia completa para empresas: <span class="block">TI, segurança eletrônica e sistemas sob medida</span></h1>
      <p class="hero__lead" data-intro style="--n:1">Suporte de TI, segurança eletrônica e desenvolvimento de sistemas com base em São Paulo e atendimento em todo o Brasil.</p>
      <div class="hero__actions" data-intro style="--n:2">
        <a class="btn btn--primary" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> Chamar no WhatsApp</a>
        <a class="text-link" href="#servicos">Ver os serviços</a>
      </div>
    </div>
    <nav class="hero__index" aria-label="Serviços" data-intro style="--n:3">
      <ul class="wrap">
        {
          services.map((s) => (
            <li>
              <a href={s.href ?? `#${s.id}`}>
                {s.short}
                <small>{s.audience}</small>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>

  <!-- Serviços -->
  <section class="section" id="servicos" data-scene="servicos" data-track-zone="servicos" aria-labelledby="servicos-title">
    <div class="wrap">
      <header class="section-head">
        <h2 id="servicos-title">O que a Solution Play faz por você</h2>
        <p>Quatro áreas, uma equipe. Veja o que está incluso em cada uma e peça um orçamento direto pelo WhatsApp.</p>
      </header>

      <div class="service-list">
        {
          services.map((s, i) => (
            <article class:list={["service-row", { "is-open": i === 0 }]} id={s.id} data-card data-track-service={s.id}>
              <h3 class="service-row__h">
                <button class="service-row__head" type="button" data-expand aria-expanded={i === 0 ? "true" : "false"} aria-controls={`inc-${s.id}`}>
                  <span class="service-row__icon"><Icon name={s.icon} /></span>
                  <span>
                    <span class="service-row__title">
                      {s.title}
                      {s.isNew ? <span class="tag-new">Novo</span> : null}
                    </span>
                    <span class="service-row__audience">{s.audience}</span>
                  </span>
                  <span class="service-row__toggle" aria-hidden="true"><Icon name="plus" /></span>
                </button>
              </h3>
              <div class="service-row__body" id={`inc-${s.id}`}>
                <div class="service-row__inner">
                  <p class="service-row__summary">{s.summary}</p>
                  <ul class="checklist" aria-label="O que está incluso">
                    {s.includes.map((item) => <li>{item}</li>)}
                  </ul>
                  <div class="service-row__cta">
                    <a class="text-link text-link--orange" href={whatsappLink(s.message)} target="_blank" rel="noopener">
                      <Icon name="whatsapp" /> Pedir orçamento pelo WhatsApp
                    </a>
                    {s.href ? <a class="text-link" href={s.href}>Ver a página de {s.short}</a> : null}
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Por que a Solution Play -->
  <section class="section" id="base" data-scene="base" aria-labelledby="base-title">
    <div class="wrap why">
      <div>
        <h2 id="base-title">Uma equipe só para toda a tecnologia da sua empresa</h2>
        <ul class="why__diff">
          {differentiators.map((d) => <li>{d}</li>)}
        </ul>
        <ul class="why__facts">
          {
            trust.map((t) => (
              <li>
                <Icon name={t.icon} />
                <span>{t.text}</span>
              </li>
            ))
          }
        </ul>
        <Stats />
      </div>
    </div>
  </section>

  <!-- Clientes e depoimentos (só aparece quando houver dados em content.ts) -->
  <Testimonials scene="base" />

  <!-- Como contratar -->
  <section class="section" id="atendimento" data-scene="atendimento" aria-labelledby="atendimento-title">
    <div class="wrap">
      <header class="section-head">
        <h2 id="atendimento-title">Como você pode contratar</h2>
        <p>Do chamado de um dia ao contrato completo. O escopo é montado junto com você, sem pacote engessado.</p>
      </header>

      <div class="engage">
        {
          engagement.map((e) => (
            <article>
              <h3>{e.title}</h3>
              <span class="engage__when">{e.tag}</span>
              <p class="engage__desc">{e.desc}</p>
              <ul class="checklist">
                {e.includes.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))
        }
      </div>

      <div class="policies">
        {
          policies.map((p) => (
            <div>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Blog (só aparece quando houver posts) -->
  <BlogTeaser scene="atendimento" />

  <!-- Contato -->
  <section class="section" id="contato" data-scene="contato" data-track-zone="contato" aria-labelledby="contato-title">
    <div class="wrap contact">
      <div>
        <h2 id="contato-title">Fale com um especialista</h2>
        <p class="contact__lead">Conte o que está acontecendo. A primeira resposta chega em até 4 horas úteis.</p>
        <a class="contact__phone" href={whatsappLink()} target="_blank" rel="noopener" aria-label={`Chamar no WhatsApp ${brand.whatsappDisplay}`}>
          <Icon name="whatsapp" />
          {brand.whatsappDisplay}
        </a>
        <ul class="contact__facts">
          <li><Icon name="phone" /> <a href={phoneLink}>Ligar: {brand.phoneDisplay}</a></li>
          <li><Icon name="clock" /> {brand.hours}</li>
          <li><Icon name="mail" /> <a href={`mailto:${brand.email}`}>{brand.email}</a></li>
          <li><Icon name="map" /> {brand.area}</li>
        </ul>
      </div>
      <ContactForm />
    </div>
  </section>
</SiteLayout>
