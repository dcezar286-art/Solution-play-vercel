---
/**
 * Modelo das páginas de serviço (Suporte de TI, Segurança Eletrônica, NOC).
 * O conteúdo vem de src/data/servicePages.ts.
 */
import SiteLayout from "../../layouts/SiteLayout.astro";
import Icon from "./Icon.astro";
import { brand, whatsappLink } from "../../data/content";
import { servicePages, type ServicePageData } from "../../data/servicePages";

interface Props {
  page: ServicePageData;
  current: "ti" | "seguranca" | "noc";
}
const { page, current } = Astro.props;
const pageUrl = `${brand.siteUrl}${page.slug}`;

const related = [
  ...Object.entries(servicePages)
    .filter(([key]) => key !== current)
    .map(([, p]) => ({ href: p.slug, name: p.name })),
  { href: "/desenvolvimento/", name: "Desenvolvimento de sistemas" },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: page.h1,
    serviceType: page.serviceType,
    url: pageUrl,
    description: page.description,
    provider: { "@type": "ProfessionalService", name: brand.name, url: `${brand.siteUrl}/`, telephone: "+55 11 93741-5034" },
    areaServed: page.areaServed ?? { "@type": "State", name: "São Paulo" },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: page.serviceType,
      itemListElement: page.items.map((i) => ({
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: i.title, description: i.desc },
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Início", item: `${brand.siteUrl}/` },
      { "@type": "ListItem", position: 2, name: page.name, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: page.faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<SiteLayout title={page.title} description={page.description} current={current} whatsappMessage={page.whatsappMessage} schema={schema}>
  <!-- Topo -->
  <section class="dev-hero" data-scene="dev-hero" aria-labelledby="page-title">
    <div class="wrap dev-hero__inner">
      <div>
        <nav class="crumbs" aria-label="Você está em" data-intro style="--n:0"><a href="/">Início</a><span aria-hidden="true">/</span>{page.name}</nav>
        <h1 id="page-title" class="dev-hero__title" data-intro style="--n:0">{page.h1}</h1>
        <p class="hero__lead" data-intro style="--n:1">{page.lead}</p>
        <div class="hero__actions" data-intro style="--n:2">
          <a class="btn btn--primary" href={whatsappLink(page.whatsappMessage)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Pedir orçamento no WhatsApp</a>
          <a class="text-link" href="#o-que-fazemos">Ver o que está incluso</a>
        </div>
      </div>

      <dl class="spec-sheet" data-intro style="--n:2">
        {
          page.facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- O que fazemos -->
  <section class="section" id="o-que-fazemos" data-scene="dev-solucoes" aria-labelledby="itens-title">
    <div class="wrap">
      <header class="section-head">
        <h2 id="itens-title">O que está incluso</h2>
      </header>
      <div class="solution-grid">
        {
          page.items.map((item) => (
            <article class="solution">
              <h3>{item.title}</h3>
              <p class="solution__desc">{item.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Para quem é -->
  <section class="section" id="para-quem" data-scene="dev-stack" aria-labelledby="publico-title">
    <div class="wrap stack">
      <header class="section-head">
        <h2 id="publico-title">Para quem é</h2>
      </header>
      <ul class="why__diff audience">
        {page.audience.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </section>

  <!-- Como funciona (sequência real, por isso numerada) -->
  <section class="section" id="como-funciona" data-scene="dev-processo" aria-labelledby="passos-title">
    <div class="wrap">
      <header class="section-head">
        <h2 id="passos-title">Como funciona</h2>
      </header>
      <ol class="process process--4">
        {
          page.steps.map((s, i) => (
            <li>
              <span class="process__num" aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Perguntas -->
  <section class="section" id="perguntas" data-scene="dev-faq" aria-labelledby="faq-title">
    <div class="wrap faq">
      <header class="section-head">
        <h2 id="faq-title">Perguntas frequentes</h2>
      </header>
      <div>
        {
          page.faq.map((f) => (
            <details class="faq__item">
              <summary>{f.q}<Icon name="plus" /></summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Chamada final + outros serviços -->
  <section class="section" data-scene="dev-cta" aria-labelledby="cta-title">
    <div class="wrap">
      <div class="cta-band">
        <div>
          <h2 id="cta-title">Vamos conversar sobre o seu caso?</h2>
          <p>Conte o que você precisa. A primeira resposta chega em até 4 horas úteis.</p>
        </div>
        <a class="btn btn--primary btn--lg" href={whatsappLink(page.whatsappMessage)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Chamar no WhatsApp</a>
      </div>
      <nav class="related" aria-labelledby="related-title">
        <h2 id="related-title">Outros serviços da Solution Play</h2>
        <ul>
          {related.map((r) => <li><a class="text-link" href={r.href}>{r.name}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>
</SiteLayout>
