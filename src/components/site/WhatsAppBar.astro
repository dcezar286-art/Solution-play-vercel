---
/** Barra fixa do WhatsApp — só aparece no celular, sempre ao alcance do polegar. */
import Icon from "./Icon.astro";
import { brand, whatsappLink } from "../../data/content";

interface Props {
  message?: string;
}
const { message } = Astro.props;
---

<div class="wa-bar" data-wa-bar>
  <a class="btn btn--primary wa-bar__main" href={whatsappLink(message)} target="_blank" rel="noopener">
    <Icon name="whatsapp" /> Chamar no WhatsApp
  </a>
  <a class="wa-bar__alt" href={`mailto:${brand.email}`} aria-label="Enviar e-mail">
    <Icon name="mail" />
  </a>
</div>
