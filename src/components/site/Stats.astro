---
/** Números da empresa. Fica oculto enquanto o array `stats` em content.ts estiver vazio. */
import { stats } from "../../data/content";
---

{
  stats.length > 0 && (
    <dl class="stats">
      {stats.map((s) => (
        <div>
          <dt>{s.label}</dt>
          <dd>{s.value}</dd>
        </div>
      ))}
    </dl>
  )
}
